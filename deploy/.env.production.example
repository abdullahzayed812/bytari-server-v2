# =============================================================================
# Bytari — PRODUCTION environment (VPS: /opt/bytari/.env, chmod 600, owner root)
#
# Read by docker compose (variable interpolation) AND passed to the `api`
# container (`env_file`). Never commit the real file. Everything here is
# BACKEND-ONLY — the web app's public config is baked in at image build time
# (client repo, EXPO_PUBLIC_* build args) and contains no secrets.
#
# `deploy/scripts/check-env.sh` validates this file before every deploy.
# =============================================================================

# --- images (set by the deploy script; defaults used for a manual `up`) ------
API_IMAGE=ghcr.io/abdullahzayed812/bytari-server-v2
WEB_IMAGE=ghcr.io/abdullahzayed812/bytari-client-v2
API_TAG=latest
WEB_TAG=latest

# --- domains (edge nginx + CORS) ---------------------------------------------
# Canonical web origin and API host. Changing these also requires editing
# deploy/nginx/conf.d/bytari.conf and re-issuing the certificate.
PUBLIC_WEB_ORIGIN=https://baytari.com
LETSENCRYPT_EMAIL=baytariapp@gmail.com

# --- runtime -------------------------------------------------------------------
LOG_LEVEL=info
# Explicit allow-list — `*` is rejected by the app when NODE_ENV=production.
# Native mobile apps send no Origin header, so they are unaffected by CORS.
CORS_ORIGINS=https://baytari.com,https://www.baytari.com
BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# --- PostgreSQL 16 (the `db` container; internal network only) ---------------
DB_NAME=bytari
DB_USER=bytari
# Generate: openssl rand -base64 32 | tr -d '/+=' | cut -c1-32
DB_PASSWORD=CHANGE_ME
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=30000

# --- identity -----------------------------------------------------------------
# >= 32 chars. Generate: openssl rand -base64 48
JWT_ACCESS_SECRET=CHANGE_ME
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
# Password hashing (argon2id) — same values as development.
ARGON2_MEMORY_KIB=19456
ARGON2_ITERATIONS=2
ARGON2_PARALLELISM=1

# First admin — created by `migrate.js seed` when BOTH are set (password >= 12).
# Remove them from this file after the first successful deploy.
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=

# --- email (verification codes) ------------------------------------------------
EMAIL_USER=baytariapp@gmail.com
# Gmail App Password (not the account password).
EMAIL_PASS=CHANGE_ME
# Defaults to EMAIL_USER when unset.
# EMAIL_FROM=

# --- realtime (WebSocket at wss://api.baytari.com/realtime) ----------------------
REALTIME_ENABLED=true
REALTIME_PATH=/realtime
REALTIME_MAX_CONNECTIONS=10000

# --- Firebase Admin (FCM push) — backend only ----------------------------------
# Same project as the mobile google-services.json (`bytari`). Either the trio…
FIREBASE_PROJECT_ID=bytari
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@bytari.iam.gserviceaccount.com
# PEM on ONE line with literal \n sequences, wrapped in double quotes.
FIREBASE_PRIVATE_KEY=CHANGE_ME
# …or the whole service-account JSON (raw or base64).
# FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Cloudflare R2 — REQUIRED in production (blank = volatile in-memory store) --
R2_ACCOUNT_ID=e9d53627a10f82c5f66da84d8ce39cf6
R2_ACCESS_KEY_ID=CHANGE_ME
R2_SECRET_ACCESS_KEY=CHANGE_ME
R2_BUCKET=bytari-assets
R2_PUBLIC_BASE_URL=https://pub-884b1b05d7dc4b9db0bba4df9a6985cb.r2.dev
R2_FORCE_PATH_STYLE=true
R2_SIGNED_URL_TTL_SECONDS=900

# --- AI replies (consultations / inquiries) -------------------------------------
AI_TOOLKIT_ENABLED=true
AI_TOOLKIT_URL=https://toolkit.rork.com/text/llm/
AI_TOOLKIT_TIMEOUT_MS=20000
