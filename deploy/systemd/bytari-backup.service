# Daily database backup → Google Drive. Triggered by bytari-backup.timer.
# Install: see server/docs/BACKUPS.md
[Unit]
Description=Bytari daily database backup to Google Drive
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/opt/bytari
ExecStart=/opt/bytari/deploy/scripts/backup-offsite.sh
# A big upload on a slow link must not be killed early.
TimeoutStartSec=2h
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
