# ---------------------------------------------------------------------------
# Bytari Backend — environment configuration
# Copy to `.env` for local development. NEVER commit a real `.env`.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# HTTP
# Comma-separated list of allowed CORS origins, or "*" for any.
CORS_ORIGINS=*
BODY_LIMIT=1mb

# Rate limiting (applied to the whole API)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# ---------------------------------------------------------------------------
# Database
# Either set DATABASE_URL, or the discrete DB_* values below.
# DATABASE_URL takes precedence when present.
# ---------------------------------------------------------------------------
# DATABASE_URL=postgres://bytari:bytari@localhost:5435/bytari

DB_HOST=localhost
DB_PORT=5435
DB_NAME=bytari
DB_USER=bytari
DB_PASSWORD=bytari
DB_SSL=false
# Verify the DB server certificate chain (only relevant when DB_SSL=true).
# Leave false for managed Postgres that presents a private CA.
DB_SSL_REJECT_UNAUTHORIZED=false
DB_POOL_MIN=2
DB_POOL_MAX=10
# Per-connection statement_timeout in ms (0 disables). Caps runaway queries.
DB_STATEMENT_TIMEOUT_MS=30000

# ---------------------------------------------------------------------------
# Identity / JWT (Phase 2)
# ---------------------------------------------------------------------------
# HS256 secret for access tokens. REQUIRED (>=32 chars) when NODE_ENV=production.
# In development a random per-process value is used if left blank.
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
JWT_ISSUER=bytari
JWT_AUDIENCE=bytari-app
# Stricter per-IP limit for /auth/login|register|refresh
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=20
# Argon2id tuning (defaults follow OWASP guidance)
ARGON2_MEMORY_KIB=19456
ARGON2_ITERATIONS=2
ARGON2_PARALLELISM=1

# Optional development ADMIN — created by `npm run db:seed` only when BOTH are set.
# Never commit real credentials; production should provision admins another way.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_FIRST_NAME=System
BOOTSTRAP_ADMIN_LAST_NAME=Administrator

# ---------------------------------------------------------------------------
# Real-time (WebSocket) gateway
# ---------------------------------------------------------------------------
REALTIME_ENABLED=true
REALTIME_PATH=/realtime
REALTIME_PING_INTERVAL_MS=30000
# Dev-only: accept unauthenticated sockets. Forced off when NODE_ENV=production.
REALTIME_ALLOW_ANONYMOUS=false
# Hard cap on concurrent WebSocket connections per node (0 disables the cap).
# Excess upgrades are rejected with HTTP 503.
REALTIME_MAX_CONNECTIONS=10000

# ---------------------------------------------------------------------------
# Firebase Cloud Messaging (push notifications) — optional, all-or-nothing.
# Leave blank to run with the logging no-op provider.
# Provide the trio below, OR FIREBASE_SERVICE_ACCOUNT_JSON (raw or base64).
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# PEM string; literal "\n" sequences are converted to newlines.
FIREBASE_PRIVATE_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=

# ---------------------------------------------------------------------------
# Cloudflare R2 object storage — optional, all-or-nothing (except PUBLIC_BASE_URL).
# Leave blank to run with the in-memory storage (volatile, dev/test only).
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public bucket / CDN base used to build public object URLs (optional).
R2_PUBLIC_BASE_URL=
R2_FORCE_PATH_STYLE=true
R2_SIGNED_URL_TTL_SECONDS=900
