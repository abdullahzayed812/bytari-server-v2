{
  "name": "bytari-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Veterinary Platform — central backend (Phase 1: Foundation)",
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md,yml,yaml}\"",
    "test": "NODE_ENV=test tsx src/database/migrate.ts latest && vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "NODE_ENV=test tsx src/database/migrate.ts latest && vitest run test/integration",
    "test:watch": "vitest",
    "test:coverage": "NODE_ENV=test tsx src/database/migrate.ts latest && vitest run --coverage",
    "db:migrate": "tsx src/database/migrate.ts latest",
    "db:rollback": "tsx src/database/migrate.ts rollback",
    "db:status": "tsx src/database/migrate.ts status",
    "db:seed": "tsx src/database/migrate.ts seed",
    "db:seed:dev": "tsx src/database/dev-seed/run.ts",
    "db:migrate:prod": "node dist/database/migrate.js latest",
    "db:seed:prod": "node dist/database/migrate.js seed",
    "db:migrate:make": "tsx ./node_modules/knex/bin/cli.js --knexfile knexfile.ts migrate:make -x ts --stub src/database/stubs/migration.stub",
    "db:seed:make": "tsx ./node_modules/knex/bin/cli.js --knexfile knexfile.ts seed:make -x ts --stub src/database/stubs/seed.stub"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.716.0",
    "@aws-sdk/s3-request-presigner": "^3.716.0",
    "@node-rs/argon2": "^2.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "firebase-admin": "^13.0.2",
    "helmet": "^8.1.0",
    "http-status-codes": "^2.3.0",
    "jose": "^5.9.6",
    "knex": "^3.1.0",
    "nodemailer": "^9.1.0",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "swagger-ui-express": "^5.0.1",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^20.17.12",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.7",
    "@types/ws": "^8.5.13",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^2.1.8"
  }
}
